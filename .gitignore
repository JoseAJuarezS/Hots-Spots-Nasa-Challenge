# Base de datos local generada desde los CSV (pesa cientos de MB)
analisis/*.duckdb
analisis/*.duckdb.wal
# Los datos de FIRMS viven fuera del repo, en $FIRMS_DATA_DIR (ver mise.toml)
datos_crudos/
datos_firms/
*.csv.part

# Configuración local de mise (p. ej. otra FIRMS_DATA_DIR)
mise.local.toml

# Entorno virtual del backend
backend/.venv/
__pycache__/

# Salidas exportadas por los análisis (se regeneran con mise)
analisis/salida/*
!analisis/salida/.gitkeep
